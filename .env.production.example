# ============================================================
# 7Rays Astro Vastu — Production Environment Variables Template
# ============================================================
# Populate these variables in Cloudflare Pages dashboard under:
# Project Settings > Environment Variables > Production
#
# NOTE: All VITE_* variables are bundled into frontend JavaScript
# and are client-visible. DO NOT store private API keys or database
# credentials with a VITE_ prefix.
# ============================================================

# Production Domain & Canonical URL
VITE_SITE_URL=https://7raysastrovastu.com
VITE_SITE_NAME="7Rays Astro Vastu"
VITE_SITE_DEFAULT_TITLE="7Rays Astro Vastu | Vastu & Astrology Consultation in Bangalore"
VITE_SITE_DEFAULT_DESCRIPTION="Vastu Shastra and Vedic Astrology consultations in Bengaluru led by Certified Vastu Consultant Rishwa Sinha. Non-demolition energy alignment for modern spaces."

# Google Analytics 4 (Public Client Measurement ID)
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager (Public Container ID)
VITE_GTM_CONTAINER_ID=GTM-XXXXXXX

# Google Search Console Verification Token (Meta Tag Token)
VITE_GSC_VERIFICATION_TOKEN=google-site-verification-token-here

# Google Maps API Key (Public Client Key, Domain-Restricted in Google Cloud Console)
VITE_GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Authoritative Physical Headquarters (Dasarahalli, Bengaluru 560024)
VITE_OFFICE_LATITUDE=13.0645
VITE_OFFICE_LONGITUDE=77.5875
VITE_OFFICE_ADDRESS="3J64+827, Balaji Layout, H A Farm Post, Bhuvaneswari Nagar, Dasarahalli, Bengaluru, Karnataka 560024, India"

# Authoritative Business Contact (Verified Owner Numbers)
VITE_BUSINESS_PHONE="+91 70910 21616"
VITE_BUSINESS_DISPLAY_PHONE="+91 70910 21616"
VITE_WHATSAPP_PHONE=917091021616
VITE_WHATSAPP_DEFAULT_MESSAGE="Hello 7Rays Astro Vastu, I would like to book an Astro-Vastu consultation."

# Consultation Booking & Contact Form Endpoints (Optional external webhook / API)
# Leave blank to use integrated edge analytics & local tracking
VITE_CONSULTATION_FORM_ENDPOINT=""
VITE_CONTACT_FORM_ENDPOINT=""
